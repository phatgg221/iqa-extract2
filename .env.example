# Public — sent to the browser. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret — server and worker only. Never prefix this with NEXT_PUBLIC_.
# Get it from: Dashboard > Project Settings > API keys > service_role
SUPABASE_SECRET_KEY=

# Bucket that holds uploaded PDFs (created by the migration).
SUPABASE_BUCKET=documents
